{
  "data_path": "data/hu_load_15min.csv",
  "artifact_path": "artifacts/model.joblib",
  "output_path": "outputs/forecast.csv",
  "timezone": "Europe/Budapest",
  "timestamp_column": "Időpont",
  "timestamp_format": "%Y.%m.%d %H:%M:%S %z",
  "actual_column": "Nettó terhelés",
  "tso_column": "Nettó rendszerterhelés becslés (dayahead)",
  "holdout_days": 28,
  "include_weather": true,
  "target_mode": "residual",
  "objective": "l1",
  "quantile_tau": 0.5,
  "random_seed": 42,
  "n_jobs": -1
}